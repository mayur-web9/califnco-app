# Server Environment Variables (.env)
# Never commit the actual .env file or credentials to git.

PORT=3001
NODE_ENV=development

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=gen-lang-client-0022579334
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=gen-lang-client-0022579334.firebaseapp.com

# ── Razorpay (Test Mode Keys) ─────────────────────────────────────────────────
# Server startup exits with error in production if these are missing or placeholders
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# ── Email Notifications (Brevo REST API v3) ───────────────────────────────────
# 300 free transactional emails/day without credit card
BREVO_API_KEY=
EMAIL_FROM=orders@califnco.com

# ── SMS Notifications (TextBee Free Android Gateway) ──────────────────────────
# Uses Android phone connected to TextBee app (zero TRAI DLT registration cost)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
