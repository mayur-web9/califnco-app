# Server Environment Variables (.env)
# Never commit the actual .env file or credentials to git.

PORT=3001
NODE_ENV=development

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=gen-lang-client-0022579334
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=gen-lang-client-0022579334.firebaseapp.com

# ── Razorpay (Test Mode Keys) ─────────────────────────────────────────────────
# Server startup exits with error in production if these are missing or placeholders
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# ── Email Notifications (Brevo REST API v3 / Resend) ──────────────────────────
# Brevo: 300 free emails/day without credit card (https://www.brevo.com)
BREVO_API_KEY=xkeysib-
# Resend: 3,000 free emails/month (https://resend.com)
RESEND_API_KEY=re_
EMAIL_FROM=orders@califnco.com

# ── SMS Notifications (TextBee / Fast2SMS / Twilio) ───────────────────────────
# TextBee: Free Android SIM gateway (zero TRAI DLT cost, https://textbee.dev)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Fast2SMS: Free India Quick SMS credits on signup (https://www.fast2sms.com)
FAST2SMS_API_KEY=
# Twilio SMS (Optional):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── WhatsApp Automation (WAHA / Built-in Mock Gateway) ────────────────────────
# Set to local backend for 100% free simulated broadcast without personal account:
WAHA_URL=http://localhost:3001/waha
# Or set to Docker instance: http://localhost:3000
