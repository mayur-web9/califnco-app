# Copy this file to .env in each package and fill in real values.
# Never commit .env files to git.

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK (server only, keep secret)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ── Razorpay (test keys only) ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Brevo REST API / SMTP or EmailJS) ──────────────────────────────
# Brevo free tier: 300 emails/day forever without credit card
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=orders@califnco.com
# Optional EmailJS configuration
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ── SMS (TextBee Free Android Gateway) ────────────────────────────────────────
# Free Android Gateway: routes via Android phone SIM, bypassing TRAI DLT fees
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_textbee_device_id_here

# ── Address Search (Geoapify) ─────────────────────────────────────────────────
GEOAPIFY_API_KEY=

# ── AI / Automation ───────────────────────────────────────────────────────────
GROQ_API_KEY=
HF_API_KEY=

# ── Instagram (Meta Graph API) ────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_IG_USER_ID=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
