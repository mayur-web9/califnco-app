# Copy this file to .env in each package and fill in real values.
# Never commit .env files to git.

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK (server only, keep secret)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ── Razorpay (test keys only) ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (EmailJS or SMTP) ───────────────────────────────────────────────────
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASS=

# ── SMS (TextBee) ─────────────────────────────────────────────────────────────
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# ── Address Search (Geoapify) ─────────────────────────────────────────────────
GEOAPIFY_API_KEY=

# ── AI / Automation ───────────────────────────────────────────────────────────
GROQ_API_KEY=
HF_API_KEY=

# ── Instagram (Meta Graph API) ────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_IG_USER_ID=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
