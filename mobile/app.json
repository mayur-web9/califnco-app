{
  "expo": {
    "name": "Califnco",
    "slug": "mayur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a2540"
      },
      "package": "com.califnco.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0a2540"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a2540"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "c0a650c0-157a-49d9-a232-318ed74a7a62"
      }
    },
    "owner": "mayur-web9s-team"
  }
}
